# ===================================================================
#  MANNA / SELAH — environment variables
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local (it is gitignored).
# ===================================================================

# ----- AI engine (REQUIRED) ----------------------------------------
# Anthropic (Claude) secret key — used ONLY on the server.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to "claude-sonnet-4-6". Use "claude-opus-4-7" for
# the deepest responses, or a cheaper model to reduce cost.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Supabase (REQUIRED) -----------------------------------------
# The NEXT_PUBLIC_* pair is used by the browser; the non-prefixed pair
# is read by the server (middleware / OAuth callback). Set all four.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ===================================================================
#  OPTIONAL — only needed for the prayer-reminder push feature.
#  Leave blank to run MANNA without push notifications.
# ===================================================================

# Service-role key (server-only!) — lets the cron job read every user's
# reminder row to send pushes. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address embedded in push requests (optional).
VAPID_SUBJECT=mailto:hello@example.com

# Shared secret protecting /api/cron/send-reminders. The scheduler must
# send it as the "x-cron-secret" request header.
CRON_SECRET=

# Branding label used in push notification titles (optional).
APP_BRAND_LABEL=MANNA

# ----- Mobile (Capacitor) build only -------------------------------
# Where the packaged app should send API calls. Empty for the web build.
NEXT_PUBLIC_API_BASE=
